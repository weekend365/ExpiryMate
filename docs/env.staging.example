# Railway Staging — API Service Variables
# Copy into Railway → api → Variables, then replace hostnames/secrets with real values.
# This file sets NODE_ENV=production, so keys must satisfy apps/api production-env.ts
# (https CORS/privacy/auth-link URLs, APPLE_APP_STORE_ENVIRONMENT=production, etc.).

NODE_ENV=production
PORT=4000

# Railway Postgres — use Variable Reference: ${{postgres.DATABASE_URL}}
DATABASE_URL=

# Generate: openssl rand -base64 48
AUTH_TOKEN_SECRET=
AUTH_ALLOW_DEV_FALLBACK=false
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT_STORE=database
TRUST_PROXY=1

# Public HTTPS hosts after Railway domains are attached (see docs/PROJECT.md)
CORS_ORIGIN_ADMIN=https://admin-staging.up.railway.app
# Native RN does not send Origin; keep an https origin for Expo web / CORS allowlist.
CORS_ORIGIN_MOBILE=https://app-staging.up.railway.app
ADMIN_BASE_URL=https://admin-staging.up.railway.app
# Public HTTPS API host for email verify/reset bridge links (required)
AUTH_LINK_BASE_URL=https://api-staging.up.railway.app
PRIVACY_POLICY_URL=https://admin-staging.up.railway.app/privacy
PRIVACY_CHOICES_URL=https://admin-staging.up.railway.app/privacy/choices
PRIVACY_CONTACT_EMAIL=privacy@mail.devnamu.com

APP_BASE_URL=expirymate://
DEFAULT_OWNER_KEY=demo-user

# SMTP — configure before email auth flows
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="Jango <noreply@mail.devnamu.com>"

# OAuth — optional until providers are enabled
APPLE_OAUTH_CLIENT_ID=com.expirymate.mobile
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
OAUTH_PROVIDER_REDIRECT_URI=https://api-staging.up.railway.app/oauth/callback
OAUTH_APP_RETURN_URIS=expirymate://oauth

# OpenAI — required while RECIPE_AI_ENABLED or the default-on photo parse is enabled
OPENAI_API_KEY=
RECIPE_AI_MODEL=gpt-5.4-mini
RECIPE_AI_CANDIDATE_MODEL=gpt-5.6-terra
RECIPE_AI_CANDIDATE_PERCENT=0
RECIPE_AI_ENABLED=true
# Photo intake is on by default; set false/0/off as an ops kill switch.
INVENTORY_PHOTO_PARSE_ENABLED=true
INVENTORY_PHOTO_PARSE_FREE_DAILY_LIMIT=1
INVENTORY_PHOTO_PARSE_REWARDED_DAILY_LIMIT=3
INVENTORY_PHOTO_PARSE_REWARDED_ADS_ENABLED=true
INVENTORY_PHOTO_PARSE_MODEL=gpt-5.6-luna
INVENTORY_PHOTO_PARSE_RATE_LIMIT_MAX=3
INVENTORY_PHOTO_PARSE_RATE_LIMIT_WINDOW_SECONDS=60
INVENTORY_PHOTO_PARSE_DAILY_COST_LIMIT_USD=0.20
INVENTORY_PHOTO_PARSE_GLOBAL_DAILY_COST_LIMIT_USD=10
INVENTORY_PHOTO_PARSE_MAX_INFLIGHT=3
INVENTORY_PHOTO_PARSE_MAX_OUTPUT_TOKENS=1800
INVENTORY_PHOTO_PARSE_MAX_BYTES=4194304
RECIPE_RATE_LIMIT_MAX=3
RECIPE_RATE_LIMIT_WINDOW_SECONDS=60
RECIPE_FREE_DAILY_LIMIT=1
RECIPE_REWARDED_DAILY_LIMIT=10
RECIPE_SUBSCRIBER_DAILY_LIMIT=30
RECIPE_ABSOLUTE_DAILY_LIMIT=30
RECIPE_ADS_DISABLED_FREE_DAILY_LIMIT=4
# Staging exercises every offer. Use core for the initial production launch.
MONETIZATION_OFFER_MODE="expanded"
MONETIZATION_UNIT_ECONOMICS_GUARDRAILS_ENABLED=false
MONETIZATION_GUARDRAIL_LOOKBACK_DAYS=30
MONETIZATION_GUARDRAIL_MIN_SAMPLES=50
MONETIZATION_GUARDRAIL_CACHE_SECONDS=300
REWARDED_AD_COST_COVERAGE_TARGET=1
PAID_CREDIT_COST_COVERAGE_TARGET=3
MONETIZATION_SUBSCRIBER_DAILY_AI_BUDGET_KRW=
MONETIZATION_HOUSEHOLD_DAILY_AI_BUDGET_KRW=
MONETIZATION_EXPERIMENT_SALT="staging-monetization-v1"
MONETIZATION_VALUE_FIRST_ROLLOUT_PERCENT=100
PERSONALIZED_MONETIZATION_OFFERS_ENABLED=true
PERSONALIZED_MONETIZATION_OFFERS_ROLLOUT_PERCENT=100
MONETIZATION_REVENUE_LEDGER_ENABLED=true
MONETIZATION_REVENUE_LEDGER_ROLLOUT_PERCENT=100
HOUSEHOLD_SUBSCRIPTIONS_ENABLED=true
HOUSEHOLD_SUBSCRIPTIONS_ROLLOUT_PERCENT=100
RECIPE_VALUE_FIRST_FREE_DAILY_LIMIT=2
RECIPE_VALUE_FIRST_REWARDED_DAILY_LIMIT=2
RECIPE_HOUSEHOLD_DAILY_LIMIT=60
HOUSEHOLD_SUBSCRIPTION_MEMBER_LIMIT=5
BARCODE_REWARDS_ENABLED=true
BARCODE_REWARD_ROLLOUT_PERCENT=100
BARCODE_REWARD_DAILY_LIMIT=3
BARCODE_REWARD_BALANCE_LIMIT=10
BARCODE_REWARD_TOKEN_SECRET=replace-with-a-long-random-secret
BARCODE_CONTRIBUTION_EXTRA_BLOCKED_TERMS=
BARCODE_CONTRIBUTION_ALLOWED_TERMS=
PAID_RECOMMENDATION_CREDITS_ENABLED=false
RECOMMENDATION_CREDIT_PRODUCTS=expirymate_recipe_credits_5:5,expirymate_recipe_credits_15:15
REWARDED_ADS_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_RESYNC_SCHEDULER_ENABLED=false

# Coupang Partners — secrets stay on the API service only
AFFILIATE_OFFERS_ENABLED=false
AFFILIATE_OFFERS_ROLLOUT_PERCENT=0
AFFILIATE_OFFER_CACHE_SECONDS=1800
AFFILIATE_OFFER_STALE_SECONDS=21600
AFFILIATE_MAX_PRODUCTS_PER_INGREDIENT=3
COUPANG_PARTNERS_TRACKING_LINK=
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
COUPANG_PARTNERS_SUB_ID=
COUPANG_REPORT_SYNC_ENABLED=false
MINIMUM_MOBILE_APP_VERSION=
RECIPE_DAILY_COST_LIMIT_USD=1
RECIPE_GLOBAL_DAILY_COST_LIMIT_USD=10
RECIPE_MAX_INFLIGHT=5
RECIPE_AI_MAX_OUTPUT_TOKENS=2500

AI_DATA_NOTICE_VERSION=ai-data-notice-v4
PUSH_REMINDER_SCHEDULER_ENABLED=false

# IAP — production-env requires store environment=production; sandbox receipts need IAP_ALLOW_SANDBOX_PURCHASES=true only for deliberate QA
ADMOB_IOS_REWARDED_AD_UNIT_ID=
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=
ADMOB_SSV_USER_ID_SECRET=
IAP_ALLOWED_PRODUCT_IDS=expirymate_premium_monthly,expirymate_premium_yearly,jango_plus,expirymate_household_monthly,expirymate_household_yearly,jango_household
MONETIZATION_ESTIMATES_JSON=
IAP_ALLOW_SANDBOX_PURCHASES=false
APPLE_BUNDLE_ID=com.expirymate.mobile
APPLE_APP_STORE_ENVIRONMENT=production
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_PRIVATE_KEY=
APPLE_ROOT_CERTIFICATES_BASE64=
APPLE_APP_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.expirymate.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_RTDN_AUDIENCE=https://api-staging.up.railway.app/subscriptions/notifications/google

# Optional observability — see docs/PROJECT.md §5 Sentry
SENTRY_DSN=
GIT_SHA=
APP_VERSION=0.1.0

# ─── Admin Service Build Args (Railway → admin → Build Variables) ───
# Required for Docker image build (apps/admin/Dockerfile has no defaults).
NEXT_PUBLIC_API_BASE_URL=https://api-staging.up.railway.app
NEXT_PUBLIC_APP_ENV=production
PRIVACY_CONTACT_EMAIL=privacy@mail.devnamu.com
# SENTRY_DSN=...                    # jango-admin
# NEXT_PUBLIC_SENTRY_DSN=...        # same DSN as SENTRY_DSN (client)
