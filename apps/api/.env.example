DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expirymate?schema=public"
PORT=4000
CORS_ORIGIN_ADMIN="http://localhost:3000"
CORS_ORIGIN_MOBILE="http://localhost:8081"
DEFAULT_OWNER_KEY="demo-user"
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
AUTH_ALLOW_DEV_FALLBACK="false"
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
# Auth rate limits: database (default with Prisma) or memory (local unit tests)
AUTH_RATE_LIMIT_STORE="database"
# Express trust proxy hops for request.ip (Railway: 1). false/0 disables.
TRUST_PROXY="1"
APP_BASE_URL="expirymate://"
# HTTPS host for email verify/reset links (opens a bridge that deep-links into the app)
AUTH_LINK_BASE_URL="http://localhost:4000"
ADMIN_BASE_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Display names with spaces need quotes: "\"장고야 부탁해\" <noreply@mail.example.com>"
SMTP_FROM="Jango <no-reply@expirymate.local>"
APPLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
KAKAO_OAUTH_CLIENT_ID=""
KAKAO_OAUTH_CLIENT_SECRET=""
NAVER_OAUTH_CLIENT_ID=""
NAVER_OAUTH_CLIENT_SECRET=""
# HTTPS provider callback (must match Kakao/Naver/Google console)
OAUTH_PROVIDER_REDIRECT_URI="https://api.example.com/oauth/callback"
# Exact app return URIs allowed after callback (comma-separated, no wildcards)
OAUTH_APP_RETURN_URIS="expirymate://oauth"
ADMIN_EMAIL="admin@expirymate.local"
ADMIN_PASSWORD="admin1234"
PRIVACY_POLICY_URL="http://localhost:3000/privacy"
PRIVACY_CHOICES_URL="http://localhost:3000/privacy/choices"
PRIVACY_CONTACT_EMAIL="privacy@expirymate.local"
# In-app support ticket inbox (falls back to PRIVACY_CONTACT_EMAIL)
SUPPORT_INBOX_EMAIL="support@expirymate.local"
AI_DATA_NOTICE_VERSION="ai-data-notice-v2"
OPENAI_API_KEY=""
RECIPE_AI_MODEL="gpt-5.4-mini"
RECIPE_AI_ENABLED="true"
RECIPE_RATE_LIMIT_MAX=3
RECIPE_RATE_LIMIT_WINDOW_SECONDS=60
RECIPE_FREE_DAILY_LIMIT=1
RECIPE_REWARDED_DAILY_LIMIT=3
RECIPE_SUBSCRIBER_DAILY_LIMIT=30
RECIPE_ABSOLUTE_DAILY_LIMIT=30
RECIPE_ADS_DISABLED_FREE_DAILY_LIMIT=4
# Stable server-side experiment assignment. Keep the salt unchanged once live.
MONETIZATION_EXPERIMENT_SALT="development-monetization-v1"
MONETIZATION_VALUE_FIRST_ROLLOUT_PERCENT=0
RECIPE_VALUE_FIRST_FREE_DAILY_LIMIT=2
RECIPE_VALUE_FIRST_REWARDED_DAILY_LIMIT=2
BARCODE_REWARDS_ENABLED=false
BARCODE_REWARD_ROLLOUT_PERCENT=0
BARCODE_REWARD_DAILY_LIMIT=3
BARCODE_REWARD_BALANCE_LIMIT=10
BARCODE_REWARD_TOKEN_SECRET=""
REWARDED_ADS_ENABLED="false"
SUBSCRIPTIONS_ENABLED="false"
MINIMUM_MOBILE_APP_VERSION=""
RECIPE_DAILY_COST_LIMIT_USD=1
RECIPE_GLOBAL_DAILY_COST_LIMIT_USD=10
RECIPE_MAX_INFLIGHT=5
PUSH_REMINDER_SCHEDULER_ENABLED="false"
PUSH_REMINDER_SCHEDULER_INTERVAL_MINUTES=30
PUSH_REMINDER_DELIVERY_HOUR=9
PUSH_REMINDER_MAX_ATTEMPTS=3
PUSH_REMINDER_TIMEZONE_OFFSET_MINUTES=540
# Re-send rows stuck in pending after a crash (minutes)
PUSH_REMINDER_STALE_PENDING_MINUTES=15
# Wait before polling Expo receipts for accepted tickets
PUSH_REMINDER_RECEIPT_MIN_AGE_MINUTES=5
PUSH_REMINDER_RECEIPT_BATCH_SIZE=100
EXPO_PUSH_ACCESS_TOKEN=""
ADMOB_IOS_REWARDED_AD_UNIT_ID=""
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=""
ADMOB_SSV_USER_ID_SECRET=""
IAP_ALLOWED_PRODUCT_IDS="expirymate_premium_monthly,expirymate_premium_yearly,jango_plus"
# Dev/staging: omit or set true when testing TestFlight/Play license purchases
IAP_ALLOW_SANDBOX_PURCHASES="true"
APPLE_BUNDLE_ID="com.expirymate.mobile"
APPLE_APP_STORE_ENVIRONMENT="sandbox"
APPLE_APP_STORE_ISSUER_ID=""
APPLE_APP_STORE_KEY_ID=""
APPLE_APP_STORE_PRIVATE_KEY=""
APPLE_ROOT_CERTIFICATES_BASE64=""
APPLE_APP_ID=""
GOOGLE_PLAY_PACKAGE_NAME="com.expirymate.mobile"
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_RTDN_AUDIENCE=""
