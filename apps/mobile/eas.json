{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true,
        "scheme": "ExpiryMateQA",
        "buildConfiguration": "Debug-QA"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_IOS_PERSONAL_TEAM": "0",
        "APP_VARIANT": "development"
      },
      "developmentClient": true
    },
    "development-device": {
      "extends": "development",
      "distribution": "internal",
      "developmentClient": true,
      "ios": {
        "simulator": false,
        "scheme": "ExpiryMateQA",
        "buildConfiguration": "Debug-QA"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_IOS_PERSONAL_TEAM": "1",
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": false,
        "scheme": "ExpiryMate",
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_IOS_PERSONAL_TEAM": "0",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "production"
      }
    },
    "store-qa": {
      "extends": "production",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "APP_VARIANT": "production",
        "EXPO_IOS_PERSONAL_TEAM": "0",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "JANGO_STORE_QA": "true",
        "JANGO_STORE_QA_APP_VERSION": "1.4.5",
        "JANGO_STORE_QA_API_ORIGIN": "https://api-qa-c321.up.railway.app",
        "EXPO_PUBLIC_OAUTH_REDIRECT_URI": "https://api-qa-c321.up.railway.app/oauth/callback",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-qa-c321.up.railway.app"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "latest",
        "resourceClass": "medium",
        "scheme": "ExpiryMate",
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_IOS_PERSONAL_TEAM": "0",
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.expirymate.mobile",
        "ascAppId": "6793375883"
      },
      "android": {
        "track": "internal"
      }
    },
    "store-qa": {
      "ios": {
        "bundleIdentifier": "com.expirymate.mobile",
        "ascAppId": "6793375883"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
