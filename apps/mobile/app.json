{
  "expo": {
    "name": "장고야 부탁해",
    "slug": "expirymate",
    "description": "Jango (장고야 부탁해) — Korean-first ingredient inventory, expiry reminder, and recipe recommendation app.",
    "platforms": ["ios", "android"],
    "scheme": "expirymate",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1F3F5",
    "primaryColor": "#10B981",
    "icon": "./assets/branding/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf",
            "./assets/fonts/Pretendard-ExtraBold.otf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#10B981",
          "defaultChannel": "expiry-reminders"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F1F3F5"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "바코드와 유통기한을 스캔해 식재료를 등록하려면 카메라 접근이 필요합니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "로그인 정보를 안전하게 지키기 위해 Face ID를 쓸 수 있어요."
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "expirymate",
          "project": "mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.expirymate.mobile",
      "buildNumber": "1",
      "icon": "./assets/branding/icon.png",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"],
        "aps-environment": "development"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleDisplayName": "장고야 부탁해",
        "LSMinimumSystemVersion": "12.0",
        "NSCameraUsageDescription": "바코드와 유통기한을 스캔해 식재료를 등록하려면 카메라 접근이 필요합니다.",
        "UIRequiresFullScreen": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.expirymate.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "icon": "./assets/branding/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#F1F3F5"
      }
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "enforceContrast": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c64c29f-a2bb-4416-99c3-0b4d88898ea6"
      }
    },
    "owner": "devnamu"
  }
}
