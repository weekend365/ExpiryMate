# Root reference file for the ExpiryMate monorepo.
# Each app reads its own environment file in development.

# apps/api/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expirymate?schema=public"
PORT=4000
CORS_ORIGIN_ADMIN="http://localhost:3000"
CORS_ORIGIN_MOBILE="http://localhost:8081"
DEFAULT_OWNER_KEY="demo-user"
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
AUTH_ALLOW_DEV_FALLBACK="false"
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
APP_BASE_URL="expirymate://"
# HTTPS host for email verify/reset links (opens a bridge that deep-links into the app)
AUTH_LINK_BASE_URL="http://localhost:4000"
ADMIN_BASE_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ExpiryMate <no-reply@expirymate.local>"
APPLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
KAKAO_OAUTH_CLIENT_ID=""
KAKAO_OAUTH_CLIENT_SECRET=""
NAVER_OAUTH_CLIENT_ID=""
NAVER_OAUTH_CLIENT_SECRET=""
OAUTH_PROVIDER_REDIRECT_URI="https://api-production-1504.up.railway.app/oauth/callback"
OAUTH_APP_RETURN_URIS="expirymate://oauth"
ADMIN_EMAIL="admin@expirymate.local"
ADMIN_PASSWORD="admin1234"
PRIVACY_POLICY_URL="http://localhost:3000/privacy"
PRIVACY_CHOICES_URL="http://localhost:3000/privacy/choices"
PRIVACY_CONTACT_EMAIL="privacy@expirymate.local"
SUPPORT_INBOX_EMAIL="support@expirymate.local"
AI_DATA_NOTICE_VERSION="ai-data-notice-v3"
OPENAI_API_KEY=""
RECIPE_AI_MODEL="gpt-5.4-mini"
# Set false/0/off to stop all OpenAI recipe generations (ops kill switch)
RECIPE_AI_ENABLED="true"
RECIPE_RATE_LIMIT_MAX=3
RECIPE_RATE_LIMIT_WINDOW_SECONDS=60
RECIPE_FREE_DAILY_LIMIT=1
RECIPE_REWARDED_DAILY_LIMIT=10
RECIPE_SUBSCRIBER_DAILY_LIMIT=30
RECIPE_ABSOLUTE_DAILY_LIMIT=30
RECIPE_ADS_DISABLED_FREE_DAILY_LIMIT=4
MONETIZATION_EXPERIMENT_SALT="development-monetization-v1"
MONETIZATION_VALUE_FIRST_ROLLOUT_PERCENT=0
PERSONALIZED_MONETIZATION_OFFERS_ENABLED="false"
PERSONALIZED_MONETIZATION_OFFERS_ROLLOUT_PERCENT=0
MONETIZATION_REVENUE_LEDGER_ENABLED="false"
MONETIZATION_REVENUE_LEDGER_ROLLOUT_PERCENT=0
HOUSEHOLD_SUBSCRIPTIONS_ENABLED="false"
HOUSEHOLD_SUBSCRIPTIONS_ROLLOUT_PERCENT=0
RECIPE_VALUE_FIRST_FREE_DAILY_LIMIT=2
RECIPE_VALUE_FIRST_REWARDED_DAILY_LIMIT=2
RECIPE_HOUSEHOLD_DAILY_LIMIT=60
HOUSEHOLD_SUBSCRIPTION_MEMBER_LIMIT=5
BARCODE_REWARDS_ENABLED=false
BARCODE_REWARD_ROLLOUT_PERCENT=0
BARCODE_REWARD_DAILY_LIMIT=3
BARCODE_REWARD_BALANCE_LIMIT=10
BARCODE_REWARD_TOKEN_SECRET=
BARCODE_CONTRIBUTION_EXTRA_BLOCKED_TERMS=
BARCODE_CONTRIBUTION_ALLOWED_TERMS=
REWARDED_ADS_ENABLED="false"
SUBSCRIPTIONS_ENABLED="false"
AFFILIATE_OFFERS_ENABLED="false"
AFFILIATE_OFFERS_ROLLOUT_PERCENT=0
AFFILIATE_OFFER_CACHE_SECONDS=86400
COUPANG_PARTNERS_TRACKING_LINK=""
COUPANG_PARTNERS_ACCESS_KEY=""
COUPANG_PARTNERS_SECRET_KEY=""
MINIMUM_MOBILE_APP_VERSION=""
RECIPE_DAILY_COST_LIMIT_USD=1
# Account-wide daily OpenAI spend cap across all owners (0 = disabled)
RECIPE_GLOBAL_DAILY_COST_LIMIT_USD=10
# Max concurrent OpenAI generations in this API process (0 = disabled)
RECIPE_MAX_INFLIGHT=5
RECIPE_AI_MAX_OUTPUT_TOKENS=2500
RECIPE_AI_INPUT_COST_PER_1M_TOKENS=0.25
RECIPE_AI_CACHED_INPUT_COST_PER_1M_TOKENS=0.025
RECIPE_AI_OUTPUT_COST_PER_1M_TOKENS=2
PUSH_REMINDER_SCHEDULER_ENABLED="false"
PUSH_REMINDER_SCHEDULER_INTERVAL_MINUTES=30
PUSH_REMINDER_DELIVERY_HOUR=9
PUSH_REMINDER_MAX_ATTEMPTS=3
PUSH_REMINDER_TIMEZONE_OFFSET_MINUTES=540
EXPO_PUSH_ACCESS_TOKEN=""
ADMOB_IOS_REWARDED_AD_UNIT_ID=""
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=""
ADMOB_SSV_USER_ID_SECRET=""
IAP_ALLOWED_PRODUCT_IDS="expirymate_premium_monthly,expirymate_premium_yearly,jango_plus,expirymate_household_monthly,expirymate_household_yearly,jango_household"
IAP_ALLOW_SANDBOX_PURCHASES="false"
SUBSCRIPTION_RESYNC_SCHEDULER_ENABLED="false"
SUBSCRIPTION_RESYNC_INTERVAL_MINUTES=360
SUBSCRIPTION_RESYNC_BATCH_SIZE=50
SUBSCRIPTION_RESYNC_STALE_HOURS=6
SUBSCRIPTION_RESYNC_VOIDED_LOOKBACK_DAYS=7
# JSON: usdKrw, rewardedAdEcpmKrw(per 1,000 verified impressions), productNetProceedsKrw.
# Product keys use store:productId[:basePlanId]. Keep empty until estimates are reviewed.
MONETIZATION_ESTIMATES_JSON='{"usdKrw":0,"rewardedAdEcpmKrw":0,"productNetProceedsKrw":{}}'
APPLE_BUNDLE_ID="com.expirymate.mobile"
APPLE_APP_STORE_ENVIRONMENT="sandbox"
APPLE_APP_STORE_ISSUER_ID=""
APPLE_APP_STORE_KEY_ID=""
APPLE_APP_STORE_PRIVATE_KEY=""
APPLE_ROOT_CERTIFICATES_BASE64=""
APPLE_APP_ID=""
GOOGLE_PLAY_PACKAGE_NAME="com.expirymate.mobile"
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_RTDN_AUDIENCE=""

# Optional observability (leave empty to disable). See docs/PROJECT.md §5 Sentry.
# Production: set on Railway API service (never commit real DSNs).
# Sentry project: jango-api (NestJS / Node)
SENTRY_DSN=""

# apps/admin/.env.local
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
PRIVACY_CONTACT_EMAIL="privacy@expirymate.local"
ADMOB_PUBLISHER_ID=""
# Production: Railway Admin. Sentry project: jango-admin (Next.js)
# SENTRY_DSN = server; NEXT_PUBLIC_SENTRY_DSN = browser (same DSN recommended)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# apps/mobile/.env
EXPO_PUBLIC_API_BASE_URL="http://localhost:4000"
EXPO_PUBLIC_APP_ENV="development"
EXPO_PUBLIC_APP_VERSION="1.2.0"
EXPO_PUBLIC_IAP_PRODUCT_IDS="expirymate_premium_monthly,expirymate_premium_yearly,expirymate_household_monthly,expirymate_household_yearly"
EXPO_PUBLIC_WEB_BASE_URL="http://localhost:3000"
EXPO_PUBLIC_ADMOB_IOS_APP_ID=""
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=""
EXPO_PUBLIC_ADMOB_IOS_REWARDED_AD_UNIT_ID=""
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_AD_UNIT_ID=""
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=""
EXPO_PUBLIC_KAKAO_OAUTH_CLIENT_ID=""
EXPO_PUBLIC_NAVER_OAUTH_CLIENT_ID=""
# Optional — provider redirect URI lives on the API (OAUTH_PROVIDER_REDIRECT_URI)
# EXPO_PUBLIC_OAUTH_REDIRECT_URI="https://api-production-1504.up.railway.app/oauth/callback"
# Production/preview: EAS secret (eas secret:create --name EXPO_PUBLIC_SENTRY_DSN ...)
# Sentry project: jango-mobile (React Native). Skipped when EXPO_PUBLIC_APP_ENV=development.
EXPO_PUBLIC_SENTRY_DSN=""
